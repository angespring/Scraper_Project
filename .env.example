# Google service account JSON path
GOOGLE_SERVICE_ACCOUNT=service_account.json
# Google Sheet name or ID
GOOGLE_SHEET_NAME=product jobs scraper
# Optional: region filter, role keywords, etc.
REGION=US,CA
ROLE_KEYWORDS=product owner,product manager

# AngeOS URL Intake Chrome Extension
# TODO: Supply your Notion internal integration token before building.
ANGEOS_NOTION_TOKEN=
# TODO: Supply the database IDs for each queue.
ANGEOS_NOTION_CAPTURE_INBOX_DB_ID=
ANGEOS_NOTION_NETWORKING_QUEUE_DB_ID=
ANGEOS_NOTION_RESOURCE_QUEUE_DB_ID=
ANGEOS_NOTION_CAREER_QUEUE_DB_ID=
ANGEOS_NOTION_EVENT_QUEUE_DB_ID=
ANGEOS_NOTION_ACTIVITY_LOG_DB_ID=
# TODO: Update these only if your title property names differ from `Name`.
ANGEOS_NOTION_CAPTURE_TITLE_PROPERTY=Name
ANGEOS_NOTION_ACTIVITY_TITLE_PROPERTY=Name
